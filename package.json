{
    "name": "react-native-aes-crypto",
    "version": "4.0.0",
    "description": "AES encryption/decryption native module for React Native",
    "main": "lib/commonjs/index",
    "module": "lib/module/index",
    "types": "lib/typescript/index.d.ts",
    "react-native": "src/index",
    "source": "src/index",
    "files": [
        "src",
        "lib",
        "android",
        "ios",
        "react-native-aes.podspec",
        "!android/build",
        "!ios/build",
        "!**/__tests__"
    ],
    "scripts": {
        "prepare": "bob build",
        "test": "jest",
        "typecheck": "tsc --noEmit -p tsconfig.build.json",
        "lint": "eslint src/",
        "format": "prettier --write src/"
    },
    "keywords": [
        "react-native",
        "aes",
        "crypto",
        "encryption",
        "decryption",
        "pbkdf2",
        "hmac",
        "sha256",
        "sha512"
    ],
    "repository": {
        "type": "git",
        "url": "git://github.com/tectiv3/react-native-aes.git"
    },
    "author": "tectiv3",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/tectiv3/react-native-aes/issues"
    },
    "homepage": "https://github.com/tectiv3/react-native-aes",
    "peerDependencies": {
        "react": ">=18.0.0",
        "react-native": ">=0.75.0"
    },
    "devDependencies": {
        "@types/jest": "^29.0.0",
        "jest": "^29.0.0",
        "react": "^18.0.0",
        "react-native": "^0.75.0",
        "react-native-builder-bob": "^0.35.0",
        "ts-jest": "^29.0.0",
        "typescript": "^5.0.0"
    },
    "jest": {
        "preset": "ts-jest",
        "testEnvironment": "node",
        "roots": ["<rootDir>/src"],
        "testPathIgnorePatterns": ["__mocks__"],
        "moduleNameMapper": {
            "^react-native$": "<rootDir>/src/__tests__/__mocks__/react-native.ts"
        }
    },
    "engines": {
        "node": ">=18"
    },
    "codegenConfig": {
        "name": "RNAesSpec",
        "type": "modules",
        "jsSrcsDir": "src"
    },
    "react-native-builder-bob": {
        "source": "src",
        "output": "lib",
        "targets": [
            "commonjs",
            "module",
            ["typescript", { "project": "tsconfig.build.json" }]
        ]
    }
}
